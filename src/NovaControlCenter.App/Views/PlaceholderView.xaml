<UserControl x:Class="NovaControlCenter.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageRoot}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="560">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource Accent}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Availability}" Style="{StaticResource Value}" Margin="14,0,0,0" MaxWidth="460" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
