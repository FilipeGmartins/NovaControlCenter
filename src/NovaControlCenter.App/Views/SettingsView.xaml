<UserControl x:Class="NovaControlCenter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaControlCenter.App.Controls"
             xmlns:vm="clr-namespace:NovaControlCenter.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SmallStick" TargetType="c:StickView" BasedOn="{StaticResource {x:Type c:StickView}}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
        </Style>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource PageRoot}">
        <TextBlock Text="Configurações" Style="{StaticResource H1}" />
        <TextBlock Style="{StaticResource Subtitle}">
            <Run Text="Ajustes do perfil ativo:" /> <Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
            <Run Text=" · troque de perfil na página Perfis." />
        </TextBlock>

        <!-- Onde os ajustes valem -->
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖥️" FontSize="18" VerticalAlignment="Top" />
                <TextBlock Text="{x:Static vm:SettingsViewModel.Scope}" Style="{StaticResource Value}" Margin="12,0,0,0" MaxWidth="820" />
            </StackPanel>
        </Border>

        <WrapPanel>
            <!-- Analógicos -->
            <Border Style="{StaticResource Card}" Width="420">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE7FC;" Style="{StaticResource IconGlyph}" /></Border>
                        <TextBlock Text="Analógicos" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="ESQUERDO" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding LeftDeadzone, StringFormat=0, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                        <TextBlock Text="Zona morta" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding LeftDeadzone}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}" Text="{Binding LeftCurveText}" />
                        <TextBlock Text="Curva de sensibilidade" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0.4" Maximum="3" Value="{Binding LeftCurve}" IsSnapToTickEnabled="True" TickFrequency="0.1" Margin="0,0,0,18" />

                    <TextBlock Text="DIREITO" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding RightDeadzone, StringFormat=0, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                        <TextBlock Text="Zona morta" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding RightDeadzone}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}" Text="{Binding RightCurveText}" />
                        <TextBlock Text="Curva de sensibilidade" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0.4" Maximum="3" Value="{Binding RightCurve}" IsSnapToTickEnabled="True" TickFrequency="0.1" />
                </StackPanel>
            </Border>

            <!-- Gatilhos e vibração -->
            <Border Style="{StaticResource Card}" Width="360">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}" /></Border>
                        <TextBlock Text="Gatilhos e vibração" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding TriggerDeadzone, StringFormat=0, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                        <TextBlock Text="Zona morta dos gatilhos" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding TriggerDeadzone}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding TriggerFullAt, StringFormat=0, Mode=OneWay}" /><Run Text="% do curso" /></TextBlock>
                        <TextBlock Text="Gatilho completo em" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="50" Maximum="100" Value="{Binding TriggerFullAt}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,4" />
                    <TextBlock Text="Menos de 100% = gatilho &quot;curto&quot;, ótimo para disparo rápido." Style="{StaticResource Label}" FontSize="11.5" Margin="0,0,0,18" />

                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding Vibration, StringFormat=0, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                        <TextBlock Text="Intensidade da vibração" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Vibration}" IsSnapToTickEnabled="True" TickFrequency="5" Margin="0,0,0,18" />

                    <Button Content="Restaurar ajustes neutros" Command="{Binding ResetNeutralCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Pré-visualização -->
            <Border Style="{StaticResource Card}" Width="420">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE7B3;" Style="{StaticResource IconGlyph}" /></Border>
                        <TextBlock Text="Pré-visualização" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Label}" Margin="0,0,0,14" />
                    <Grid IsEnabled="{Binding HasSource}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <c:StickView Grid.Column="0" Style="{StaticResource SmallStick}" X="{Binding RawLX}" Y="{Binding RawLY}" DotBrush="{StaticResource TextMuted}" />
                        <c:StickView Grid.Column="1" Style="{StaticResource SmallStick}" X="{Binding OutLX}" Y="{Binding OutLY}" />
                        <c:StickView Grid.Column="2" Style="{StaticResource SmallStick}" X="{Binding RawRX}" Y="{Binding RawRY}" DotBrush="{StaticResource TextMuted}" />
                        <c:StickView Grid.Column="3" Style="{StaticResource SmallStick}" X="{Binding OutRX}" Y="{Binding OutRY}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Esq. bruto" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Esq. perfil" Style="{StaticResource Label}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Dir. bruto" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Dir. perfil" Style="{StaticResource Label}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </Grid>
                    <TextBlock Text="L2: bruto / perfil" Style="{StaticResource Label}" Margin="0,16,0,4" />
                    <ProgressBar Value="{Binding RawLT, Mode=OneWay}" Style="{StaticResource TriggerBar}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                    <ProgressBar Value="{Binding OutLT, Mode=OneWay}" Style="{StaticResource TriggerBar}" Margin="0,0,0,10" />
                    <TextBlock Text="R2: bruto / perfil" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <ProgressBar Value="{Binding RawRT, Mode=OneWay}" Style="{StaticResource TriggerBar}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                    <ProgressBar Value="{Binding OutRT, Mode=OneWay}" Style="{StaticResource TriggerBar}" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
