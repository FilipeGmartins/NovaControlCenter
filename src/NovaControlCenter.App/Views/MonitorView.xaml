<UserControl x:Class="NovaControlCenter.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NovaControlCenter.App.Views"
             xmlns:conv="clr-namespace:NovaControlCenter.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <StackPanel Style="{StaticResource PageRoot}">
        <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding UpdatesPerSecond, Mode=OneWay}" /><Run Text=" atualizações/s" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="Monitoramento" Style="{StaticResource H1}" />
                <TextBlock Text="Entradas em tempo real. Aperte os botões e mova os analógicos para testar." Style="{StaticResource Subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Aviso quando não há leitura -->
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Warning}" Padding="18,14"
                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Warning}" VerticalAlignment="Center" />
                <TextBlock Text="Nenhuma leitura no momento. Ligue o controle e verifique se o receptor está conectado."
                           Style="{StaticResource Value}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Controle -->
        <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="24,20">
            <views:ControllerVisual />
        </Border>

        <WrapPanel>
            <!-- Teste de botões -->
            <Border Style="{StaticResource Card}" Width="320">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE73A;" Style="{StaticResource IconGlyph}" /></Border>
                        <TextBlock Text="Teste de botões" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Text}" FontSize="34" FontWeight="SemiBold">
                        <Run Text="{Binding Tested.Count, Mode=OneWay}" /><Run Text=" / " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding TotalButtons, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                    </TextBlock>
                    <TextBlock Text="botões detectados desde o início do teste" Style="{StaticResource Label}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding MissingButtons}" Style="{StaticResource Value}" Foreground="{StaticResource TextMuted}" FontSize="13" />
                    <Button Content="Reiniciar teste" Command="{Binding ResetTestCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Vibração -->
            <Border Style="{StaticResource Card}" Width="420">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE877;" Style="{StaticResource IconGlyph}" /></Border>
                        <TextBlock Text="Teste de vibração" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding LeftMotor, StringFormat=0, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                        <TextBlock Text="Motor esquerdo · grave" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" Value="{Binding LeftMotor}" Margin="0,0,0,14" />

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Foreground="{StaticResource Text}"><Run Text="{Binding RightMotor, StringFormat=0, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                        <TextBlock Text="Motor direito · agudo" Style="{StaticResource Label}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" Value="{Binding RightMotor}" Margin="0,0,0,18" />

                    <WrapPanel>
                        <Button Content="Pulso esquerdo" Command="{Binding PulseLeftCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="Pulso direito" Command="{Binding PulseRightCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="Ambos" Command="{Binding PulseBothCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="Parar" Command="{Binding StopVibrationCommand}" Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>
                    <CheckBox Content="Vibração contínua" IsChecked="{Binding ContinuousVibration}" Style="{StaticResource ToggleSwitch}" Margin="0,6,0,14" />
                    <TextBlock Style="{StaticResource Label}"><Run Text="Estado: " /><Run Text="{Binding VibrationStatus, Mode=OneWay}" Foreground="{StaticResource Text}" /></TextBlock>
                    <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0"
                               Text="🖥️ Aplicado por software (XInput). Nada é gravado no controle." />
                </StackPanel>
            </Border>

            <!-- Valores brutos -->
            <Border Style="{StaticResource Card}" Width="420">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconBadge}"><TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}" /></Border>
                        <TextBlock Text="Valores dos eixos" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Analógico esquerdo" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding LeftStickText}" Style="{StaticResource Mono}" />
                    <TextBlock Text="Analógico direito" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding RightStickText}" Style="{StaticResource Mono}" />
                    <TextBlock Text="Gatilhos" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding TriggersText}" Style="{StaticResource Mono}" />
                    <TextBlock Text="Botões pressionados" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding ButtonsText}" Style="{StaticResource Mono}" />
                    <TextBlock Text="Pacote XInput" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding PacketNumber}" Style="{StaticResource Mono}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
