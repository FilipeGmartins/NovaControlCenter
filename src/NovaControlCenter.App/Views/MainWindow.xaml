<Window x:Class="NovaControlCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NovaControlCenter.App.ViewModels"
        xmlns:views="clr-namespace:NovaControlCenter.App.Views"
        xmlns:conv="clr-namespace:NovaControlCenter.App.Converters"
        xmlns:p="clr-namespace:NovaControlCenter.App.Presentation"
        Title="Nova Control Center"
        Icon="/Resources/NovaControlCenter.ico"
        Width="1240" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Moldura própria: barra de título integrada, mantendo redimensionar/arrastar/encaixar do Windows -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StatusKindToBrushConverter x:Key="StatusBrush" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}"><views:MonitorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:Ds4ViewModel}"><views:Ds4View /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>

        <!-- Ponto de status: pulsa quando o controle está conectado -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static p:StatusKind.Ok}">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Barra lateral (ocupa também a faixa do título) ===== -->
        <Border Grid.RowSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,40,0,0">
                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,8,24,32">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NOVA" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="Control Center" FontSize="12" Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status dos controles no rodapé -->
                <Border DockPanel.Dock="Bottom" Margin="16,16,16,20" Padding="14,12" CornerRadius="12"
                        Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="GameSir T4 Nova Lite" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding Ds4StatusKind, Converter={StaticResource StatusBrush}}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="DualShock 4 (PS4)" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding Ds4StatusTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="MENU" Style="{StaticResource Overline}" Margin="28,0,0,8" />
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="Menu principal"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- ===== Barra de título ===== -->
        <DockPanel Grid.Column="1" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="OnMinimize" ToolTip="Minimizar" AutomationProperties.Name="Minimizar" />
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource TitleBarButton}" Click="OnMaximize" ToolTip="Maximizar" AutomationProperties.Name="Maximizar" />
                <Button Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButton}" Click="OnClose" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Conteúdo ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding SelectedPage.ViewModel}" Margin="40,8,24,24" Focusable="False" />
        </ScrollViewer>
    </Grid>
</Window>
